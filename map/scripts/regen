SOURCE_EXT = {".ts", ".tsx", ".js", ".jsx", ".mjs", ".py", ".go", ".rs", ".mdx", ".html"}
ENV_RE = re.compile(r"(?:process\.env|import\.meta\.env)\.([A-Z][A-Z0-9_]{2,})")
