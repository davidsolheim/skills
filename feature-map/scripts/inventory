    ".r": "r",
    ".xml": "xml",
    ".svg": "svg",
}

# Hints only — not the feature list. Longer / distinctive first is unnecessary;
# we scan with `needle in text`.
NEEDLES = (
    "impersonat",
    "login-as",
    "log in as",
    "act-as",
    "act as user",
    "masquerade",
    "sign-in",
    "signin",
    "sign-on",
    "oauth",
    "openid",
    "oidc",
    "saml",
    "magic link",
    "magic-link",
