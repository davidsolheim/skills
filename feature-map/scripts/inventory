#!/usr/bin/env python3
"""Walk a repo and emit JSON for /feature-map. Stdout = JSON, stderr = errors."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from collections import Counter
from pathlib import Path

MAX_READ_BYTES = 262144  # 256 KiB

SKIP_DIR_NAMES = frozenset(
    {
        ".git",
        "node_modules",
        ".next",
        ".nuxt",
        ".output",
        ".svelte-kit",
        "dist",
        "build",
        "out",
        "coverage",
        ".turbo",
        ".vercel",
        ".cache",
        "__pycache__",
        ".venv",
        "venv",
        ".tox",
        ".mypy_cache",
        ".pytest_cache",
        "target",
        "vendor",
        "Pods",
        "DerivedData",
        ".gradle",
        ".idea",
        ".parcel-cache",
        ".yarn",
        ".pnpm-store",
        "tmp",
        "temp",
        ".terragrunt-cache",
        "storybook-static",
        ".docusaurus",
        "playwright-report",
        "test-results",
        ".DS_Store",
    }
)

LOCKFILE_NAMES = frozenset(
    {
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "bun.lock",
        "bun.lockb",
        "Cargo.lock",
